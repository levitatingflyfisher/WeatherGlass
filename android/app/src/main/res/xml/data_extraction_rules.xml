<?xml version="1.0" encoding="utf-8"?>
<!--
  WeatherGlass stores its data locally and unencrypted (the privacy promise is
  "your places stay on your device"). Exclude app data from both cloud backup
  (Android 12+) and device-to-device transfer so the plaintext SQLite database
  (saved locations = home coordinates) and the shared prefs never leave the
  device via an OS mechanism. The encrypted .ohbk export is the sanctioned
  backup path. Pinned by test/android/backup_config_test.dart.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
